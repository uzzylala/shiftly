DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shiftly?schema=public"
PORT=4000
# Backs the SSE ticket store and cross-instance notification push (see
# backend/src/services/sse.service.ts). A free Upstash Redis database works
# for both local dev and Vercel — use its "ioredis"/TCP connection string
# (rediss://...), not the REST URL.
REDIS_URL="rediss://default:password@example.upstash.io:6379"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
CORS_ORIGIN="http://localhost:5173"
